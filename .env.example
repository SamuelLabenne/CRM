# Copy to .env.local for local overrides. Locally nothing is required: without DATABASE_URL
# the app uses an embedded Postgres (PGlite) in .data/pglite.
#
# Local QA account used during development (created through /setup on localhost only):
#   dev@relay.test / relay-dev-2026

# Postgres connection (production: Supabase transaction pooler, port 6543)
DATABASE_URL=

# ≥ 32 random characters – signs sessions/links and encrypts stored API keys. Never change after launch.
APP_SECRET=

# Protects /api/cron (background jobs). Supabase pg_cron sends it as a Bearer token.
CRON_SECRET=

# Required on the first-run /setup page in production so only you can claim the workspace.
SETUP_CODE=

# Public base URL used in emails (defaults to the Vercel production URL)
APP_URL=

# Optional fallback Resend key (normally configured in Settings → Email sending)
RESEND_API_KEY=
